# Copy to .env.android (never commit it) to build a signed release with:
#   docker compose run --rm android-release
# The keystore file must be inside the project folder (it is mounted at /app).
# Create one once with:
#   keytool -genkeypair -v -keystore android/release.keystore -alias scanreceipt -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH=/app/android/release.keystore
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=scanreceipt
ANDROID_KEY_PASSWORD=change-me
