{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/sql-wasm.wasm"
        ]
      }
    },
    {
      "name": "ocr",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/ocr/**"]
      }
    },
    {
      "name": "media",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**", "/*.png", "/*.(svg|woff2|woff|ttf)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "exchange-rates",
      "urls": [
        "https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@*/**",
        "https://*.currency-api.pages.dev/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 200,
        "maxAge": "365d"
      }
    }
  ]
}
