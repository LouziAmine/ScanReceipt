{
  "name": "scan-receipt",
  "version": "1.0.0",
  "description": "Offline receipt scanner for iOS and Android: on-device OCR, categories, totals and exports.",
  "license": "Apache-2.0",
  "author": "Amine Louzi",
  "homepage": "https://github.com/LouziAmine/ScanReceipt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouziAmine/ScanReceipt.git"
  },
  "bugs": {
    "url": "https://github.com/LouziAmine/ScanReceipt/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "cap:sync": "ng build && cap sync",
    "android": "ng build && cap sync android && cap open android",
    "ios": "ng build && cap sync ios && cap open ios",
    "assets": "python3 scripts/generate-native-assets.py",
    "version:set": "node scripts/bump-version.mjs",
    "android:apk": "scripts/android-build.sh debug",
    "android:release": "scripts/android-build.sh release",
    "ios:simulator": "scripts/ios-build.sh simulator",
    "ios:archive": "scripts/ios-build.sh archive"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@capgo/capacitor-document-scanner": "^8.4.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@ionic/angular": "^9.0.6",
    "fflate": "^0.8.3",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "^2.8.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "sql.js": "1.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
